# Copy to .env.local (git-ignored) and fill in for your environment.
# Never commit real values — this file must only ever contain placeholders.

# Buzz relay WebSocket URL. Matches the reference Buzz repo's own dev default
# (`just relay` → ws://localhost:3000); see docs/PROTOCOL_IMPLEMENTATION_REFERENCE.md.
# Falls back to ws://localhost:3000 automatically in dev builds if unset.
VITE_RELAY_URL=ws://localhost:3000

# Okta OIDC (Authorization Code + PKCE). Required for production sign-in;
# Development Mode (see docs/SECURITY.md) works without any of these being set.
#
# VITE_OKTA_* are read by the frontend build (Vite inlines VITE_-prefixed vars
# from .env.local automatically). SWF_BUZZ_OKTA_* are read by the Rust OIDC
# loopback flow (src-tauri/src/auth/oidc.rs) via plain std::env::var — Cargo/
# Tauri does NOT read .env.local, so these must be real exported shell
# environment variables before running `npm run tauri dev` /
# `npm run tauri build`, e.g.:
#   export SWF_BUZZ_OKTA_ISSUER=https://your-org.okta.com
#   export SWF_BUZZ_OKTA_CLIENT_ID=<public PKCE client id>
#   npm run tauri dev
# Keep the two pairs in sync — they must describe the same Okta app.
VITE_OKTA_ISSUER=
VITE_OKTA_CLIENT_ID=
SWF_BUZZ_OKTA_ISSUER=
SWF_BUZZ_OKTA_CLIENT_ID=

# "development" | "staging" | "production" — purely informational (e.g. for
# log/error context); defaults to "development" in a dev build.
VITE_ENVIRONMENT=development

# Optional: base URL of the deployment-wide admin console (a SEPARATE host
# from VITE_RELAY_URL — see docs/PROTOCOL_IMPLEMENTATION_REFERENCE.md §11).
# Leave unset unless your deployment actually exposes `/api/admin/v1/*`; the
# Platform Admin UI stays hidden without it. e.g. https://admin.your-buzz.example
VITE_ADMIN_URL=

# Base URL of the new swf-buzz-backend service (DECISIONS.md D10,
# docs/BACKEND_SESSION_DESIGN.md) — Application User / community / channel /
# message / DM HTTP+realtime API. Falls back to http://127.0.0.1:8787
# automatically in dev builds if unset (matches `swf buzz/backend`'s own
# SWF_BACKEND_BIND_ADDR default).
VITE_SWF_BACKEND_URL=http://127.0.0.1:8787

# Optional: a default community id for this deployment
# (src/features/communities/currentCommunity.ts). The new backend is
# multi-community; this app has no community-switcher UI yet, so this (or a
# community created/joined at runtime, cached client-side) is how it decides
# which community to operate against. Leave unset to let the first owner
# create one from the app instead.
VITE_SWF_COMMUNITY_ID=
